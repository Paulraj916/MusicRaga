# Build-time public origin. Leave unset for an explicit localhost preview (noindex).
# Before a real launch set SITE_URL to your actual HTTPS root origin, no path.
# SITE_URL=
ALLOW_INDEXING=false
# No account/ad secrets. Ads stay disabled; no AdSense publisher ID is fabricated.
# VITE_ values are public browser data, never a place for credentials.
