# Build-time public origin. Leave unset for an explicit localhost preview (noindex).
# Before a real launch set SITE_URL to your actual HTTPS root origin, no path.
# SITE_URL=
ALLOW_INDEXING=false
# No account/ad secrets. Ads stay disabled; no AdSense publisher ID is fabricated.
# VITE_ values are public browser data, never a place for credentials.

# Public advertising identifiers, not secret keys. Empty/default means no sellers or ad requests.
ADS_TXT_ENABLED=false
ADSENSE_PUBLISHER_ID=
ADSENSE_SLOT_ID=
# Live requests remain blocked until a real certified-CMP/privacy/approval implementation.
ADSENSE_REQUESTS_ENABLED=false

# Explicit substantive-page review allowlist. Required before ALLOW_INDEXING=true.
# Comma-separated actual curated paths; demos/unknown paths are never eligible.
REVIEWED_INDEX_PATHS=

# Optional free project preview prefix; keep / for root hosting. SITE_URL must match.
VITE_BASE_PATH=/
