{
  "name": "music-raga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --ssr scripts/entry-prerender.tsx --outDir .prerender && node scripts/prerender.mjs && python3 -m backend.build_static && node scripts/prepare-ads.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "record:demo": "node scripts/record-demo.mjs",
    "test:seo": "node scripts/check-prerender.mjs",
    "test:video": "node scripts/check-mobile-video.mjs",
    "test:backend": "python3 -m unittest discover -s backend/tests -v",
    "catalogue:serve": "python3 -m backend.server",
    "build:curated": "tsc -b && vite build && vite build --ssr scripts/entry-prerender.tsx --outDir .prerender && node scripts/prerender.mjs && node scripts/prepare-ads.mjs",
    "catalogue:bootstrap": "python3 -m backend.bootstrap",
    "test:ads": "node --test scripts/ads.test.mjs",
    "test:seo:policy": "node --test scripts/seo-policy.test.mjs",
    "test:project-host": "node scripts/check-project-host.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
