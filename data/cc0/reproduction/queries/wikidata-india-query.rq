SELECT ?song ?songLabel ?language ?languageLabel ?country ?performer ?performerLabel ?composer ?composerLabel ?date WHERE { { SELECT DISTINCT ?song WHERE { ?song wdt:P495 wd:Q668; wdt:P31/wdt:P279* wd:Q7366. } LIMIT 3000 } OPTIONAL {?song wdt:P407 ?language} OPTIONAL {?song wdt:P495 ?country} OPTIONAL {?song wdt:P175 ?performer} OPTIONAL {?song wdt:P86 ?composer} OPTIONAL {?song wdt:P577 ?date} SERVICE wikibase:label {bd:serviceParam wikibase:language "en".} } LIMIT 12000