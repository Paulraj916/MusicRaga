SELECT ?song ?songLabel ?language ?languageLabel ?country ?performer ?performerLabel ?composer ?composerLabel ?date WHERE { ?song wdt:P31 wd:Q134556; wdt:P495 wd:Q668. OPTIONAL {?song wdt:P407 ?language} OPTIONAL {?song wdt:P495 ?country} OPTIONAL {?song wdt:P175 ?performer} OPTIONAL {?song wdt:P86 ?composer} OPTIONAL {?song wdt:P577 ?date} SERVICE wikibase:label {bd:serviceParam wikibase:language "en".} } LIMIT 6000